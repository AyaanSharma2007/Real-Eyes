{
  "name": "realeyes",
  "version": "1.0.0",
  "description": "RealEyes — Real vs AI-Generated Image Guessing Game",
  "scripts": {
    "start": "cd server && npm start",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client\"",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "set-secret": "node scripts/set-secret-player.js",
    "download-dataset": "python3 scripts/download_images.py",
    "download:photorealistic": "python3 scripts/download_photorealistic_dataset.py",
    "test:gameplay": "cd server && NODE_PATH=\"./node_modules\" node \"../scripts/test_gameplay.js\""
  },
  "keywords": [
    "ai",
    "real-vs-fake",
    "image-guessing-game",
    "quiz"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
